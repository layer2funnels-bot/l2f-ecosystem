{
  "name": "l2f-ecosystem",
  "version": "0.2.0",
  "private": true,
  "description": "Layer2Funnels + Aurj ecosystem foundation: identity, workspace isolation, app access, audit, integration layer. Non-production.",
  "type": "module",
  "scripts": {
    "test": "node test/run.mjs",
    "test:pg": "DRIVERS=pg node test/run.mjs",
    "test:all": "node scripts/check-pg17.mjs && DRIVERS=pglite,pg node test/run.mjs && node scripts/restore-drill.mjs && node scripts/fmp-dryrun/run.mjs > /dev/null && node scripts/mutation-check.mjs",
    "test:mutation": "node scripts/mutation-check.mjs",
    "drill:restore": "node scripts/restore-drill.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:licences": "node scripts/check-licences.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "stack:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,storage-api,mailpit,supavisor",
    "stack:stop": "supabase stop",
    "test:stack": "PG_URL=postgres://supabase_admin:postgres@127.0.0.1:54322/postgres DRIVERS=pg node test/run.mjs",
    "stack:migrate": "node scripts/stack-migrate.mjs",
    "test:e2e": "node scripts/e2e-local.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test:e2e:ui": "node scripts/e2e-ui.mjs",
    "test:gallery": "node scripts/e2e-gallery.mjs",
    "build:web": "node scripts/build-web.mjs",
    "e2e:sheets": "node scripts/e2e-sheets.mjs",
    "check:fmp-copy": "node scripts/fmp-copy.mjs verify",
    "dryrun:fmp": "node scripts/fmp-dryrun/run.mjs",
    "rehearsal:local": "node scripts/rehearsal.mjs",
    "check:pg17": "node scripts/check-pg17.mjs",
    "test:e2e:planner": "node scripts/e2e-planner.mjs",
    "test:e2e:onboarding": "node scripts/e2e-onboarding.mjs",
    "test:e2e:media": "node scripts/e2e-media.mjs",
    "build:media": "node scripts/build-media.mjs",
    "test:e2e:drive": "node scripts/e2e-drive.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.10",
    "pg": "8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
