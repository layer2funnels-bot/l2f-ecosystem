# ---------------------------------------------------------------------------
# Funnel Mapper: environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# The ECOSYSTEM's Supabase project URL and public (anon/publishable) key: used only to renew the shared sign-in and to sign out.
# Local defaults below are the local stack's (`npx supabase status` in the repository root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public address of Funnel Mapper: used in share links and as the address the ecosystem sign-in sends people back to.
# It must also be listed in the ecosystem web app's config.js `appOrigins`.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# OPTIONAL, server-only. Automatic page thumbnails ("Capture preview" on a Page block's URL).
# A URL that contains {url} (replaced by the URL-encoded page address) and answers with an image (png, jpeg or webp, up to 5 MB),
# for example a screenshot service:
#   CAPTURE_URL_TEMPLATE=https://screenshots.example.com/v1/shot?key=SECRET&width=1280&url={url}
# Without it the editor says automatic capture is not set up and offers "Upload instead" (uploads always work).
# The page address is checked first (public http/https only, no private networks); the image is stored in the private
# `screenshots` bucket and shown to the team only. Share links never carry screenshots.
CAPTURE_URL_TEMPLATE=

# The ecosystem. One sign-in for every app: Funnel Mapper has no sign-in page; it reads the ecosystem's shared session cookie, which needs
# Funnel Mapper on the same domain as the ecosystem web app (a sub-domain or a path of it). Every read and write goes through the ecosystem
# API, which decides what each person may see and do. Server-only values.
#   ECOSYSTEM_API_URL        the ecosystem API base, e.g. https://app.example.com (local: http://127.0.0.1:8788)
#   ECOSYSTEM_WEB_URL        the ecosystem web app: its sign-in page, "All apps", your profile, Office › Admin (local: http://127.0.0.1:8788)
#   ECOSYSTEM_COOKIE_DOMAIN  the shared cookie's domain, the same as config.js `cookieDomain` (".example.com" for sub-domains; empty = this host)
ECOSYSTEM_API_URL=
ECOSYSTEM_WEB_URL=
ECOSYSTEM_COOKIE_DOMAIN=
