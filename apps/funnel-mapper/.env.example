# ---------------------------------------------------------------------------
# Funnel Mapper: environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (public) key.
# Local defaults below come from `npx supabase start` (also shown by `npx supabase status`).
# Production: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public URL of the app: used in invite / magic-link / password-reset emails and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL, server-only. Automatic page thumbnails ("Capture preview" on a Page block's URL).
# A URL that contains {url} (replaced by the URL-encoded page address) and answers with an image (png, jpeg or webp, up to 5 MB),
# for example a screenshot service:
#   CAPTURE_URL_TEMPLATE=https://screenshots.example.com/v1/shot?key=SECRET&width=1280&url={url}
# Without it the editor says automatic capture is not set up and offers "Upload instead" (uploads always work).
# The page address is checked first (public http/https only, no private networks); the image is stored in the private
# `screenshots` bucket and shown to the team only. Share links never carry screenshots.
CAPTURE_URL_TEMPLATE=

# The ecosystem: Funnel Mapper signs people in with the ecosystem's sign-in (the NEXT_PUBLIC_SUPABASE_* values above are the
# ecosystem project's URL and public key) and reads and writes everything through the ecosystem API, which decides what each
# person may see and do. Server-only values.
#   ECOSYSTEM_API_URL  the ecosystem API base, e.g. https://app.example.com (local: http://127.0.0.1:8788)
#   ECOSYSTEM_WEB_URL  the ecosystem web app, for "Office › Admin" and "Back to the apps" links (optional)
ECOSYSTEM_API_URL=
ECOSYSTEM_WEB_URL=
ECOSYSTEM_CLIENTS_APP_URL=
