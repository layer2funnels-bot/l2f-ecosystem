# ---------------------------------------------------------------------------
# Funnel Mapper Pro: environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (public) key.
# Local defaults below come from `npx supabase start` (also shown by `npx supabase status`).
# Production: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public URL of the app: used in invite / magic-link / password-reset emails and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL, server-only. Lets admins invite teammates from Settings → Team.
# Without it, invite people from Supabase → Authentication → Users → Invite user.
# NEVER expose this key to the browser (no NEXT_PUBLIC_ prefix).
# Local value: the "SERVICE_ROLE_KEY" printed by `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL, server-only. Enables the private, unlisted sign-up URL for independent users:
#   https://<your-domain>/join/<INDEPENDENT_SIGNUP_CODE>
# Anyone with that link can create their own private workspace (no access to team data). Use a long random
# value (at least 8 characters; e.g. `openssl rand -hex 16`) and share it only with people you choose.
# Leave empty to disable (the URL then returns 404). Also needs SUPABASE_SERVICE_ROLE_KEY.
INDEPENDENT_SIGNUP_CODE=

# OPTIONAL, server-only. Automatic page thumbnails ("Capture preview" on a Page block's URL).
# A URL that contains {url} (replaced by the URL-encoded page address) and answers with an image (png, jpeg or webp, up to 5 MB),
# for example a screenshot service:
#   CAPTURE_URL_TEMPLATE=https://screenshots.example.com/v1/shot?key=SECRET&width=1280&url={url}
# Without it the editor says automatic capture is not set up and offers "Upload instead" (uploads always work).
# The page address is checked first (public http/https only, no private networks); the image is stored in the private
# `screenshots` bucket and shown to the team only. Share links never carry screenshots.
CAPTURE_URL_TEMPLATE=
