// Funnel Mapper on Cloudflare, live (owner approval 13 Nov 2026). Public values only: addresses and the publishable sign-in key.
// One address for every app: Funnel Mapper is office.tabishriaz.com/fmp. The ecosystem site hands /fmp/* to this Worker through the service
// binding FMP (root wrangler.toml, functions/fmp/[[path]].js); the Worker has no public address of its own (no route, no workers.dev).
// Deploy: `npm run cf:deploy` (or Cloudflare's own build: `npm run cf:build:live`, then `npx wrangler deploy --config wrangler.production.jsonc`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funnel-mapper",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ECOSYSTEM_API_URL": "https://office.tabishriaz.com",
    "ECOSYSTEM_WEB_URL": "https://office.tabishriaz.com",
    "ECOSYSTEM_COOKIE_DOMAIN": "",
    "NEXT_PUBLIC_BASE_PATH": "/fmp",
    "NEXT_PUBLIC_SITE_URL": "https://office.tabishriaz.com/fmp",
    "NEXT_PUBLIC_SUPABASE_URL": "https://dfitnxilkezepkhdmzuh.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_086jMHSlwdsjwrFy5eWjkA_UjuKZrox"
  }
}
